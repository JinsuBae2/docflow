{
  "name": "visual-docs-workspace",
  "productName": "Docflow",
  "version": "0.1.0",
  "private": true,
  "description": "A local visual workspace for AI-assisted project documents",
  "author": "Docflow contributors",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "make:dmg": "node scripts/make-dmg.mjs"
  },
  "overrides": {
    "katex": "^0.18.2"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.55.0",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@playwright/test": "^1.64.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
