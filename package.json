{
  "name": "visual-docs-workspace",
  "productName": "Docflow",
  "version": "0.1.0",
  "private": true,
  "description": "AI와 함께 문서를 작성하고 관계와 변경을 검토하는 로컬 데스크톱 워크스페이스",
  "author": "Docflow contributors",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "npm run licenses && npm run build && electron-forge package",
    "make": "npm run licenses && npm run build && electron-forge make",
    "make:dmg": "node scripts/make-dmg.mjs",
    "licenses": "node scripts/generate-notices.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "katex": "^0.18.2"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "cytoscape": "3.34.3",
    "diff": "^9.0.0",
    "elkjs": "0.9.3",
    "github-slugger": "2.0.0",
    "lucide-react": "^1.55.0",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@babel/eslint-parser": "8.0.7",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-vite": "^5.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JinsuBae2/docflow.git"
  },
  "homepage": "https://github.com/JinsuBae2/docflow",
  "bugs": {
    "url": "https://github.com/JinsuBae2/docflow/issues"
  }
}
